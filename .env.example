# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Docker Compose reads `.env` from this directory automatically.

# Postgres password. Used by both the db and web services.
# IMPORTANT: "password" was previously committed — choose a new strong value.
POSTGRES_PASSWORD=change-this-to-a-strong-value

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string
